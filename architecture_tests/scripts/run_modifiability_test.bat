@echo off
chcp 65001 >nul
echo ==============================================================
echo   体系结构测试：系统可修改性 (Modifiability) 静态分析
echo ==============================================================
echo.
echo 测试原理：
echo 通过 Radon 工具对后端核心代码进行静态分析。
echo - 圈复杂度 (CC) 越低，证明代码逻辑越清晰，修改时引入 Bug 的风险越低。
echo - 维护性指数 (MI) 越高，证明代码的可读性和可维护性越强，易于团队接手修改。
echo.

echo 正在检查是否安装 radon...
pip show radon >nul 2>&1
if %ERRORLEVEL% NEQ 0 (
    echo [正在安装 Radon]...
    pip install radon
) else (
    echo [Radon 已安装]
)

echo.
echo --------------------------------------------------------------
echo 【测试项 1/2】：计算代码圈复杂度 (Cyclomatic Complexity)
echo 目标目录：..\..\backend\app\
echo 等级划分：A (1-5 极低) ^| B (6-10 较低) ^| C (11-20 中等) ^| D, E, F (高风险)
echo --------------------------------------------------------------
radon cc -a ../../backend/app/
echo.

echo --------------------------------------------------------------
echo 【测试项 2/2】：计算代码维护性指数 (Maintainability Index)
echo 目标目录：..\..\backend\app\
echo 等级划分：A (100-20 非常易维护) ^| B (19-10 中等) ^| C (9-0 难以维护)
echo --------------------------------------------------------------
radon mi ../../backend/app/
echo.

echo ==============================================================
echo   测试执行完毕！
echo   请将控制台输出的结果（尤其是均为 A 级的部分）截图，
echo   放入 results/modifiability/ 目录下，作为大作业报告的图文证据。
echo ==============================================================
pause
