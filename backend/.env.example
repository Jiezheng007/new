APP_NAME=Yuqing-Risk-MVP
SECRET_KEY=change-me-in-prod
ACCESS_TOKEN_TTL_MINUTES=480
DATABASE_URL=sqlite:///./yuqing.db
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
# Sentiment-analysis provider: jieba_nlp (default) or keyword_nlp (baseline).
NLP_PROVIDER=jieba_nlp

# Background scheduler that auto-fetches enabled data sources.
# Set to false to disable (e.g. for tests). Interval controls how often the
# scheduler scans and pulls each enabled source. For the course demo, lower
# this to 30 seconds so the audience can see new items appear quickly.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_FETCH_BATCH_LIMIT=20
